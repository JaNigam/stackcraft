{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "runner",
      "runtimeExecutable": "C:/Program Files/Git/bin/bash.exe",
      "runtimeArgs": ["-c", "cd services/runner && ./mvnw -q spring-boot:run"],
      "port": 8091
    },
    {
      "name": "api",
      "runtimeExecutable": "C:/Program Files/Git/bin/bash.exe",
      "runtimeArgs": ["-c", "cd services/api && PORT=8081 ./mvnw -q spring-boot:run"],
      "port": 8081
    },
    {
      "name": "web",
      "runtimeExecutable": "C:/Program Files/Git/bin/bash.exe",
      "runtimeArgs": ["-c", "cd apps/web && VITE_API_PROXY=http://localhost:8081 npm run dev"],
      "port": 5173
    }
  ]
}
