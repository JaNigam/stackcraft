# Copy to infra/.env on the VM:  cp infra/env.example infra/.env   then edit.
# NEVER commit the real .env file (it is git-ignored).
# In the GCP deployment the real file is generated from Secret Manager by the deploy step.

# Public address Caddy serves, without https://
SITE_ADDRESS=stackcraft.example.com

# Where the images live: <region>-docker.pkg.dev/<project-id>/<repository>
REGISTRY=us-central1-docker.pkg.dev/your-project-id/stackcraft
# Image tag to run (the Git commit SHA in CI, "latest" by hand)
TAG=latest

POSTGRES_PASSWORD=change-me

# PKCS#8 PEM, RS256. Generate:  openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:2048
# In .env use one line with \n between the lines, wrapped in double quotes.
STACKCRAFT_AUTH_JWT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
